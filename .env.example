# Google OAuth client with application type "Web application".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Set true when hosting behind HTTPS; false for local HTTP.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional server-only placeholder; Google ID-token sign-in uses only CLIENT_ID.
GOOGLE_CLIENT_SECRET=replace-with-your-secret-if-needed
# Persistent SQLite storage (default: data/hive.sqlite3).
# HIVE_DB_PATH=/absolute/path/to/hive.sqlite3
# Anonymous historical demo pool is disabled by default.
HIVE_ALLOW_LEGACY_POOL=false
